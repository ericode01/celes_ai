# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your keys stay on your machine.

# OpenAI (used by the planner and the error-repair loop)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id

# Brevo (used by EmailPlugin to send emails)
BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER_NAME=Your Name
EMAIL_SENDER_EMAIL=you@example.com
# Optional: defaults to the sender values above
EMAIL_REPLY_TO_NAME=
EMAIL_REPLY_TO_EMAIL=
